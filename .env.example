# Copy to .env and fill in. Never commit .env.

# Backend
DATABASE_PATH=/data/app.db
# Backend token-signing secret. Must differ from AUTH_SECRET. Generate: openssl rand -base64 32
BACKEND_JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
# Set true in production when users must verify their email before signing in.
REQUIRE_EMAIL_VERIFICATION=false
# Requests per client IP per rolling minute in the single-replica beta.
# RATE_LIMIT_REGISTER=8
# RATE_LIMIT_LOGIN=20
# RATE_LIMIT_PASSWORD_RESET=8
# RATE_LIMIT_VERIFICATION_EMAIL=8
# RATE_LIMIT_INVITATION=20
# RATE_LIMIT_AI=30
# Monthly workspace budget for assistant requests/actions.
# AI_MONTHLY_ACTION_LIMIT=500
# LLM: any OpenAI-compatible API; OpenRouter by default (https://openrouter.ai/keys)
LLM_API_KEY=
# Optional. Must support tool calling; free models change often.
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Transactional email via Resend (backend only; use a verified sender in production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional Reply-To address
RESEND_REPLY_TO=

# Product analytics and error tracking via PostHog. Optional: with no project token the app
# runs exactly as before and no events are sent.
# The project token is a write-only ingestion key and is safe in client code; a personal API
# key is privileged and must never be set here.
POSTHOG_PROJECT_TOKEN=
# Region-specific ingestion host. EU projects must use eu.i.posthog.com, US us.i.posthog.com.
POSTHOG_HOST=https://eu.i.posthog.com
# development | staging | production. Reported with every event and exception.
APP_ENV=development
# Optional release identifier (a git sha), reported as $app_version.
APP_RELEASE=

# Frontend
# The browser needs the same two values; Next.js only exposes NEXT_PUBLIC_* to client code.
# These are inlined at build time, so a production image must be rebuilt to change them.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Session replay is off unless this is exactly "true". All inputs and text are masked.
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
# NextAuth secret (server-side only). Generate: openssl rand -base64 32
AUTH_SECRET=
# Compose maps AUTH_URL to NEXTAUTH_URL (next-auth v4)
AUTH_URL=http://localhost:3000
# Server-side calls inside the compose network
BACKEND_INTERNAL_URL=http://backend:8000
# Browser-side calls via the host-published port
NEXT_PUBLIC_API_URL=http://localhost:8000
