# Kobi Nuxt application

# SQLite lives in the Docker named volume by default.
NUXT_DATABASE_PATH=/data/kobi.db

# Required in production. Generate with: openssl rand -base64 32
# Must contain at least 32 characters and remain server-side.
NUXT_SESSION_PASSWORD=

# Ask Kobi. Optional: without a provider key, Kobi uses its local grounded planner.
NUXT_LLM_API_KEY=
NUXT_LLM_BASE_URL=https://openrouter.ai/api/v1
# Legacy fallback for chat mode; use the mode-specific variables below for new deployments.
NUXT_LLM_MODEL=openai/gpt-4.1-mini
NUXT_LLM_CHAT_MODEL=openai/gpt-4.1-mini
NUXT_LLM_PLAN_MODEL=openai/gpt-4.1

# Optional PostHog product analytics and error tracking.
NUXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NUXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
