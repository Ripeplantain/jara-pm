# Kobi Nuxt application

# SQLite lives in the Docker named volume by default.
NUXT_DATABASE_PATH=/data/kobi.db

# Required in production. Generate with: openssl rand -base64 32
# Must contain at least 32 characters and remain server-side.
NUXT_SESSION_PASSWORD=

# Ask Kobi. Optional: without a provider key, Kobi uses its local grounded planner.
NUXT_LLM_API_KEY=
NUXT_LLM_BASE_URL=https://openrouter.ai/api/v1
# One model serves every Ask Kobi message. It needs a long, schema-valid JSON reply rather
# than deep reasoning, so any replacement must support OpenRouter structured outputs
# (Kobi sends reasoning disabled and requires endpoints that honour the schema).
# NUXT_LLM_CHAT_MODEL and NUXT_LLM_PLAN_MODEL are no longer read: a deployment that still
# sets them silently gets this model instead.
NUXT_LLM_MODEL=deepseek/deepseek-v4.1-flash

# Optional PostHog product analytics and error tracking.
NUXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NUXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
